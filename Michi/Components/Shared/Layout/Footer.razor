@using Michi.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

<footer class="site-footer">
	<div class="footer-container">
		
		<div class="footer-columns">
			<!-- Producto -->
			<div class="footer-column">
				<h3>@Localizer["Product"]</h3>
				<nav>
					<ul>
						<li><a href="/dictionary">@Localizer["Dictionary"]</a></li>
						<li><a href="/learn">@Localizer["Learn"]</a></li>
						<li><a href="/statistics">@Localizer["Statistics"]</a></li>
					</ul>
				</nav>
			</div>

			<!-- Info -->
			<div class="footer-column">
				<h3>@Localizer["Info"]</h3>
				<nav>
					<ul>
						<li><a href="/about">@Localizer["About"]</a></li>
						<li><a href="/contact">@Localizer["Contact"]</a></li>
						<li><a href="/faq">@Localizer["FAQ"]</a></li>
					</ul>
				</nav>
			</div>

			<!-- Legal -->
			<div class="footer-column">
				<h3>@Localizer["Legal"]</h3>
				<nav >
					<ul>
						<li><a href="/privacy">@Localizer["PrivacyPolicy"]</a></li>
						<li><a href="/cookies">@Localizer["CookiesPolicy"]</a></li>
						<li><a href="/terms">@Localizer["TermsAndConditions"]</a></li>
					</ul>
				</nav>
			</div>

		</div>
		
		<!-- Copirught -->
		<div class="footer-bottom">
			<p>&copy; 2026 Michi. @Localizer["AllRightsReserved"]</p>
		</div>
	</div>
</footer>